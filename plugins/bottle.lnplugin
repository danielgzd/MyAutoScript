#!name=瓶子签到与凭证捕获
#!desc=仅每日签到，首次捕获登录凭证后自动运行，无需每天打开 App。北京时间08:05执行，09:05/12:05补查。
#!author=danielgzd

[Script]
request if ${url} ~= /^https?:\/\/pingxin-api\.samaliong\.top(?::(?:80|443))?\/(?:member|fateMail|pingzi)\/[A-Za-z0-9/_-]+(?:\?.*)?$/ then script("https://raw.githubusercontent.com/danielgzd/MyAutoScript/main/scripts/loon-bottle-checkin.js?v=20261125-auto7", "mode=capture") with requires_body=true, timeout=5, tag="瓶子凭证与模板捕获"
response if ${url} ~= /^https?:\/\/pingxin-api\.samaliong\.top(?::(?:80|443))?\/fateMail\/taskList(?:\?.*)?$/ then script("https://raw.githubusercontent.com/danielgzd/MyAutoScript/main/scripts/loon-bottle-checkin.js?v=20261125-auto7", "mode=capture") with requires_body=true, timeout=5, tag="瓶子凭证响应校验"
response if ${url} ~= /^https?:\/\/pingxin-api\.samaliong\.top(?::(?:80|443))?\/fateMail\/taskList(?:\?.*)?$/ then script("https://raw.githubusercontent.com/danielgzd/MyAutoScript/main/scripts/loon-bottle-checkin.js?v=20261125-auto7", "mode=capture") with requires_body=true, timeout=5, tag="瓶子凭证响应校验"
cron "5 8,9,12 * * *" then script("https://raw.githubusercontent.com/danielgzd/MyAutoScript/main/scripts/loon-bottle-checkin.js?v=20261125-auto7", "mode=cron") with timeout=120, tag="瓶子自动签到"
generic then script("https://raw.githubusercontent.com/danielgzd/MyAutoScript/main/scripts/loon-bottle-checkin.js?v=20261125-auto7", "mode=manual") with timeout=120, tag="瓶子手动检查"

generic then script("https://raw.githubusercontent.com/danielgzd/MyAutoScript/main/scripts/loon-bottle-checkin.js?v=20261125-auto7", "mode=notify-test") with timeout=10, tag="瓶子通知测试"
[Mitm]
hostname=pingxin-api.samaliong.top
