{
  "id": "danielgzd.signin",
  "name": "星枢 · 自动化控制台",
  "author": "danielgzd",
  "apps": [
    {
      "id": "gzd_mi_community",
      "name": "小米社区微信小程序签到",
      "desc": "自动配对捕获Cookie和wx_vip_ph；只签到，不执行浏览、点赞、评论等其他任务。",
      "script": "https://raw.githubusercontent.com/danielgzd/MyAutoScript/main/scripts/loon-mi-community-checkin.js?v=20261115-mi2",
      "keys": [
        "gzd_mi_community",
        "gzd_mi_community_ledger",
        "gzd_mi_community_lock",
        "gzd_mi_community_auth_state",
        "gzd_mi_community_url",
        "gzd_mi_community_body",
        "gzd_mi_community_capture_status",
        "gzd_mi_community_capture_at",
        "gzd_mi_community_header_Cookie",
        "gzd_mi_community_credentials",
        "gzd_mi_community_last_result",
        "gzd_mi_community_notice_status"
      ],
      "settings": [
        {
          "id": "@gzd_mi_community.enabled",
          "name": "启用小米社区签到",
          "val": true,
          "type": "boolean",
          "desc": "Loon每日08:20（设备当地时区）执行；不运行其他成长任务。"
        },
        {
          "id": "@gzd_mi_community.notifications",
          "name": "结果通知",
          "val": true,
          "type": "boolean",
          "desc": "手动检查每次反馈；定时任务相同结果当天去重。通知最终展示由Loon和iOS权限控制。"
        },
        {
          "id": "gzd_mi_community_capture_status",
          "name": "凭证捕获状态",
          "val": "",
          "type": "text",
          "desc": "成功的业务响应才覆盖凭证；401或不完整Cookie不覆盖。"
        },
        {
          "id": "gzd_mi_community_capture_at",
          "name": "最近捕获时间",
          "val": "",
          "type": "text",
          "desc": "打开小米社区微信小程序签到页后自动更新。"
        },
        {
          "id": "gzd_mi_community_header_Cookie",
          "name": "Cookie（敏感）",
          "val": "",
          "type": "text",
          "desc": "与请求URL中的wx_vip_ph成对更新。勿分享。"
        },
        {
          "id": "gzd_mi_community_credentials",
          "name": "配对登录数据（敏感）",
          "val": "",
          "type": "text",
          "desc": "由捕获规则维护；不建议手动修改，不要导出分享。"
        },
        {
          "id": "gzd_mi_community_last_result",
          "name": "最近签到结果",
          "val": "",
          "type": "text",
          "desc": "包含已签到/失败、奖励和成长值，以服务端核验结果为准。"
        },
        {
          "id": "gzd_mi_community_notice_status",
          "name": "最近通知提交状态",
          "val": "",
          "type": "text",
          "desc": "“已请求”只说明已调用Loon通知接口，不代表手机已展示。"
        }
      ]
    },
    {
      "id": "danielgzd.bottle.tasks",
      "name": "瓶子每日签到",
      "desc": "仅每日签到；首次捕获凭证后无需每天打开 App，凭证失效才需重新登录。",
      "keys": [
        "gzd_bottle",
        "gzd_bottle_headers",
        "gzd_bottle_completed",
        "gzd_bottle_lock",
        "gzd_bottle_last_error",
        "gzd_bottle_last_notification",
        "gzd_bottle_capture_at",
        "gzd_bottle_header_accessToken",
        "gzd_bottle_last_result",
        "gzd_bottle_capture_status",
        "gzd_bottle_api_base",
        "gzd_bottle_notice_status"
      ],
      "settings": [
        {
          "id": "gzd_bottle_capture_status",
          "name": "捕获状态（排错首先看这里）",
          "val": "",
          "type": "text",
          "desc": "空值表示捕获规则尚未命中；已打开App仍为空时，请确认插件安装位置、启用状态和HTTPS解密。"
        },
        {
          "id": "@gzd_bottle.enabled",
          "name": "启用自动签到",
          "val": true,
          "type": "boolean",
          "desc": "首次捕获凭证后，每日08:05签到，09:05和12:05补查。Loon需保持启用。"
        },
        {
          "id": "gzd_bottle_capture_at",
          "name": "最近捕获时间",
          "val": "",
          "type": "text",
          "desc": "自动更新。"
        },
        {
          "id": "gzd_bottle_header_accessToken",
          "name": "accessToken（敏感）",
          "val": "",
          "type": "text",
          "desc": "仅本机保存，勿分享。必须连同 App 的新签名一并捕获，不要单独覆盖旧值。"
        },
        {
          "id": "gzd_bottle_last_result",
          "name": "最近签到结果",
          "val": "",
          "type": "text",
          "desc": "记录签到是否已确认。"
        },
        {
          "id": "@gzd_bottle.notifications",
          "name": "通知总开关",
          "val": true,
          "type": "boolean",
          "desc": "控制签到脚本结果通知；通知测试入口可独立测试系统权限。"
        },
        {
          "id": "@gzd_bottle.notify_success",
          "name": "成功或部分完成通知",
          "val": true,
          "type": "boolean",
          "desc": "瓶子手动检查每次通知，定时任务相同结果当天去重。"
        },
        {
          "id": "@gzd_bottle.notify_failure",
          "name": "失败通知",
          "val": true,
          "type": "boolean",
          "desc": "瓶子手动检查每次通知；定时任务同类错误当天提醒一次。"
        },
        {
          "id": "@gzd_bottle.notify_waiting",
          "name": "缺少登录凭证提醒",
          "val": true,
          "type": "boolean",
          "desc": "手动检查每次反馈；定时检查相同等待状态当天提醒一次。"
        },
        {
          "id": "gzd_bottle_notice_status",
          "name": "最近通知提交状态",
          "val": "",
          "type": "text",
          "desc": "显示脚本是否调用了 Loon 通知接口；系统是否展示取决于通知权限、Loon设置和专注模式。"
        }
      ],
      "script": "https://raw.githubusercontent.com/danielgzd/MyAutoScript/main/scripts/loon-bottle-checkin.js?v=20261125-auto7"
    },
    {
      "id": "gzd_tuhu",
      "name": "途虎养车",
      "script": "https://raw.githubusercontent.com/danielgzd/MyAutoScript/main/scripts/tuhu.js",
      "keys": [
        "tuhu_token",
        "tuhu_blackbox"
      ],
      "settings": [
        {
          "id": "tuhu_token",
          "name": "途虎 Token（敏感）",
          "val": "[]",
          "type": "text",
          "desc": "由Loon捕获；不要分享。"
        },
        {
          "id": "tuhu_blackbox",
          "name": "blackbox（敏感）",
          "val": "",
          "type": "text",
          "desc": "由原脚本维护。"
        }
      ]
    },
    {
      "id": "danielgzd.unicom.cookie",
      "name": "中国联通 Cookie",
      "desc": "打开联通 App 刷新首页后自动捕获；供 Scriptable ChinaUnicom 使用。",
      "keys": [
        "ChinaUnicomCookie"
      ],
      "settings": [
        {
          "id": "ChinaUnicomCookie",
          "name": "联通 Cookie",
          "val": "",
          "type": "text",
          "desc": "由捕获规则更新，勿分享此内容"
        }
      ]
    }
  ],
  "icon": "https://raw.githubusercontent.com/danielgzd/MyAutoScript/main/assets/xingshu.png",
  "icons": [
    "https://raw.githubusercontent.com/danielgzd/MyAutoScript/main/assets/xingshu.png"
  ]
}
