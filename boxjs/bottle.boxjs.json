{
  "id": "danielgzd.bottle",
  "name": "Daniel 瓶子 Loon 自动任务",
  "author": "danielgzd",
  "apps": [
    {
      "id": "danielgzd.bottle.tasks",
      "name": "瓶子每日签到",
      "desc": "仅每日签到；首次捕获凭证后无需每天打开 App，凭证失效才需重新登录。",
      "keys": [
        "gzd_bottle",
        "gzd_bottle_headers",
        "gzd_bottle_completed",
        "gzd_bottle_lock",
        "gzd_bottle_last_error",
        "gzd_bottle_last_notification",
        "gzd_bottle_capture_at",
        "gzd_bottle_header_accessToken",
        "gzd_bottle_last_result",
        "gzd_bottle_capture_status",
        "gzd_bottle_api_base",
        "gzd_bottle_notice_status"
      ],
      "settings": [
        {
          "id": "gzd_bottle_capture_status",
          "name": "捕获状态（排错首先看这里）",
          "val": "",
          "type": "text",
          "desc": "空值表示捕获规则尚未命中；已打开App仍为空时，请确认插件安装位置、启用状态和HTTPS解密。"
        },
        {
          "id": "@gzd_bottle.enabled",
          "name": "启用自动签到",
          "val": true,
          "type": "boolean",
          "desc": "首次捕获凭证后，每日08:05签到，09:05和12:05补查。Loon需保持启用。"
        },
        {
          "id": "gzd_bottle_capture_at",
          "name": "最近捕获时间",
          "val": "",
          "type": "text",
          "desc": "自动更新。"
        },
        {
          "id": "gzd_bottle_header_accessToken",
          "name": "accessToken（敏感）",
          "val": "",
          "type": "text",
          "desc": "仅本机保存，勿分享。必须连同 App 的新签名一并捕获，不要单独覆盖旧值。"
        },
        {
          "id": "gzd_bottle_last_result",
          "name": "最近签到结果",
          "val": "",
          "type": "text",
          "desc": "记录签到是否已确认。"
        },
        {
          "id": "@gzd_bottle.notifications",
          "name": "通知总开关",
          "val": true,
          "type": "boolean",
          "desc": "控制签到脚本结果通知；通知测试入口可独立测试系统权限。"
        },
        {
          "id": "@gzd_bottle.notify_success",
          "name": "成功或部分完成通知",
          "val": true,
          "type": "boolean",
          "desc": "瓶子手动检查每次通知，定时任务相同结果当天去重。"
        },
        {
          "id": "@gzd_bottle.notify_failure",
          "name": "失败通知",
          "val": true,
          "type": "boolean",
          "desc": "瓶子手动检查每次通知；定时任务同类错误当天提醒一次。"
        },
        {
          "id": "@gzd_bottle.notify_waiting",
          "name": "缺少登录凭证提醒",
          "val": true,
          "type": "boolean",
          "desc": "手动检查每次反馈；定时检查相同等待状态当天提醒一次。"
        },
        {
          "id": "gzd_bottle_notice_status",
          "name": "最近通知提交状态",
          "val": "",
          "type": "text",
          "desc": "显示脚本是否调用了 Loon 通知接口；系统是否展示取决于通知权限、Loon设置和专注模式。"
        }
      ],
      "script": "https://raw.githubusercontent.com/danielgzd/MyAutoScript/main/scripts/loon-bottle-checkin.js?v=20261125-auto7"
    }
  ]
}
